  "arbitration": {
    "default_wait_max": 0.25,
    "note": "A flash due while the crown is up waits up to default_wait_max and is then dropped, except a flash with a sequence block: Resolve starts delay_after_crown_down seconds after the crown goes down (crown_up() false), waits up to wait_max, and is never dropped by arbitration (only the surge can preempt it)."
  },
  "note": "Canonical data, written by art/concepts/marked-aura/gen.mjs (Art owns data/art/). Angles are degrees (0 forward, 90 up), d and s are in units of head size / 12. Names and looks are placeholders.",
  "families": {
    "P": "circles",
    "A": "blades",
    "E": "wedges",
    "C": "steps"
  },
