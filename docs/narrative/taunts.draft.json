  },
  "generic_floor_p": 0.2,
  "seed": "match seed plus taunt index, own stream"
 },
 "lines": [
  {
   "id": "tnt-pro-001",
   "fighter": "PROTAGONIST",
   "tier": "whole",
   "family": "ladder",
   "text": "Come on. I've got all day.",
   "words": 6,
   "when": {
    "rung": "1"
   },
   "opens": [
    "dare"
   ]
  },
  {
   "id": "tnt-pro-002",
   "fighter": "PROTAGONIST",
   "tier": "whole",
   "family": "ladder",
   "text": "Just stretching. Go ahead, take your time.",
   "words": 7,
   "when": {
    "rung": "1"
   },
   "opens": [
    "stall"
   ]
  },
  {
   "id": "tnt-pro-003",
   "fighter": "PROTAGONIST",
   "tier": "whole",
   "family": "ladder",
   "text": "Still smiling. Still here.",
   "words": 4,
   "when": {
    "rung": "2-3"
   },
   "opens": [
    "needle"
   ]
  },
  {
   "id": "tnt-pro-004",
   "fighter": "PROTAGONIST",
   "tier": "whole",
   "family": "ladder",
   "text": "That's two. I'm keeping count, you know.",
   "words": 7,
   "when": {
    "rung": "2-3"
   }
  },
  {
   "id": "tnt-pro-005",
   "fighter": "PROTAGONIST",
   "tier": "whole",
   "family": "ladder",
   "text": "Okay, now I'm enjoying this.",
   "words": 5,
   "when": {
    "rung": "4-6"
   }
  },
  {
   "id": "tnt-pro-006",
   "fighter": "PROTAGONIST",
   "tier": "whole",
   "family": "ladder",
   "text": "I'll keep going if you will.",
   "words": 6,
   "when": {
    "rung": "4-6"
   },
   "opens": [
    "dare"
   ]
  },
  {
   "id": "tnt-pro-007",
   "fighter": "PROTAGONIST",
   "tier": "whole",
   "family": "ladder",
   "text": "We're really doing this, huh.",
   "words": 5,
   "when": {
    "rung": "7-12"
   }
  },
  {
   "id": "tnt-pro-008",
   "fighter": "PROTAGONIST",
   "tier": "whole",
   "family": "ladder",
   "text": "My feet hurt. Worth it.",
   "words": 5,
   "when": {
    "rung": "7-12"
   }
  },
  {
   "id": "tnt-pro-009",
   "fighter": "PROTAGONIST",
   "tier": "whole",
   "family": "ladder",
   "text": "At this point we're a landmark.",
   "words": 6,
   "when": {
    "rung": "13+"
   }
  },
  {
   "id": "tnt-pro-010",
   "fighter": "PROTAGONIST",
   "tier": "whole",
   "family": "ladder",
   "text": "Somebody's going to blink. Not me.",
   "words": 6,
   "when": {
    "rung": "13+"
   },
   "opens": [
    "dare"
   ]
  },
  {
   "id": "tnt-pro-011",
   "fighter": "PROTAGONIST",
   "tier": "whole",
   "family": "milestone",
   "text": "That's ten. Not bad, for no punching.",
   "words": 7,
   "when": {
    "standoff_count": 10
   }
  },
  {
   "id": "tnt-pro-012",
   "fighter": "PROTAGONIST",
   "tier": "whole",
   "family": "milestone",
   "text": "Twenty-five. And nobody's even hurt.",
   "words": 5,
   "when": {
    "standoff_count": 25
   }
  },
  {
   "id": "tnt-pro-013",
   "fighter": "PROTAGONIST",
   "tier": "whole",
   "family": "milestone",
   "text": "Fifty! I'll be sore tomorrow. Worth it.",
   "words": 7,
   "when": {
    "standoff_count": 50
   }
  },
  {
   "id": "tnt-pro-014",
   "fighter": "PROTAGONIST",
   "tier": "whole",
   "family": "milestone",
   "text": "A hundred. Do I get a trophy, or do you?",
   "words": 10,
   "when": {
    "standoff_count": 100
   }
  },
  {
   "id": "tnt-pro-015",
   "fighter": "PROTAGONIST",
   "tier": "whole",
   "family": "react",
   "text": "You've got a lot of fight left. Good. I'd feel bad otherwise.",
   "words": 12,
   "when": {
    "standing": "ahead"
   }
  },
  {
   "id": "tnt-pro-016",
   "fighter": "PROTAGONIST",
   "tier": "whole",
   "family": "react",
   "text": "I'm behind. I'm having a great time.",
   "words": 7,
   "when": {
    "standing": "behind"
   }
  },
  {
   "id": "tnt-pro-017",
   "fighter": "PROTAGONIST",
   "tier": "whole",
   "family": "react",
   "text": "Sorry about the crater. I'll level it out later.",
   "words": 9,
   "when": {
    "event": "crater"
   }
  },
  {
   "id": "tnt-pro-018",
   "fighter": "PROTAGONIST",
   "tier": "whole",
   "family": "react",
   "text": "Away from the town, okay? Come on out here.",
   "words": 9,
   "when": {
    "collateral": "many"
   }
  },
  {
   "id": "tnt-pro-019",
   "fighter": "PROTAGONIST",
   "tier": "whole",
   "family": "react",
   "text": "Your {part} looks sore. Want to call it?",
   "words": 8,
   "when": {
    "wound": "opp"
   }
  },
  {
   "id": "tnt-pro-020",
   "fighter": "PROTAGONIST",
   "tier": "whole",
   "family": "react",
   "text": "I can still wave with this arm.",
   "words": 7,
   "when": {
    "wound": "self"
   }
  },
  {
   "id": "tnt-pro-021",
   "fighter": "PROTAGONIST",
   "tier": "whole",
   "family": "react",
   "text": "You went bigger. So will I.",
   "words": 6,
   "when": {
    "tier": "opp_higher"
   }
  },
  {
   "id": "tnt-pro-022",
   "fighter": "PROTAGONIST",
   "tier": "whole",
   "family": "react",
   "text": "Nice day for the sea. Nobody's hurt out here.",
   "words": 9,
   "when": {
    "biome": "ocean"
   }
  },
  {
   "id": "tnt-pro-023",
   "fighter": "PROTAGONIST",
   "tier": "whole",
   "family": "react",
   "text": "Say something mean. I've missed it.",
   "words": 6,
   "when": {
    "vs": "anti_hero"
   }
  },
  {
   "id": "tnt-pro-024",
   "fighter": "PROTAGONIST",
   "tier": "whole",
   "family": "react",
   "text": "Guard, wave back. It's only polite.",
   "words": 6,
   "when": {
    "vs": "empress"
   }
  },
  {
   "id": "tnt-pro-025",
   "fighter": "PROTAGONIST",
   "tier": "whole",
   "family": "react",
   "text": "Don't tell me you're hungry. You're always hungry.",
   "words": 8,
   "when": {
    "vs": "cyborg"
   }
  },
  {
   "id": "tnt-pro-026",
   "fighter": "PROTAGONIST",
   "tier": "whole",
   "family": "answer",
   "text": "Fine. I'll come to you. Soon.",
   "words": 6,
   "when": {
    "taunted_back": true
   },
   "replies_to": [
    "dare"
   ]
  },
  {
   "id": "tnt-pro-027",
   "fighter": "PROTAGONIST",
   "tier": "whole",
   "family": "answer",
   "text": "That one was good. Do another.",
   "words": 6,
   "when": {
    "taunted_back": true
   },
   "replies_to": [
    "needle"
   ]
  },
  {
   "id": "tnt-pro-028",
   "fighter": "PROTAGONIST",
   "tier": "whole",
   "family": "answer",
   "text": "Keep your pity. Keep the sandwich, too.",
   "words": 7,
   "when": {
    "taunted_back": true
   },
   "replies_to": [
    "pity"
   ]
  },
  {
