{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/ui-howto",
  "title": "ui how to play (schema 1)",
  "description": "PROPOSED for tools/schemas/ui-howto.schema.json and a rule in tools/schemas/map.json (ui/data/howto.json). UI owns ui/ and docs/ui/, not tools/, so this waits for Tools through the EP; until then validate.js warns [no-schema] for the file. ui/data/howto.json: the How to play card's words. Version field: schema. Policy: closed. Each page has an id, a title and items; an item is a heading, a note, an action row (one glyph action or a list of them) or an icon row; col is 0 or 1.",
  "type": "object",
  "required": ["schema", "title", "buttons", "hint", "reopen", "pages"],
  "properties": {
    "schema": { "const": 1 },
    "note": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "buttons": {
      "type": "object",
      "required": ["next", "back", "done", "close"],
      "properties": {
        "next": { "type": "string", "minLength": 1 },
        "back": { "type": "string", "minLength": 1 },
        "done": { "type": "string", "minLength": 1 },
        "close": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "hint": { "type": "string", "minLength": 1 },
    "reopen": { "type": "string", "minLength": 1 },
    "pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/page" } }
  },
  "additionalProperties": false,
  "$defs": {
    "page": {
      "type": "object",
      "required": ["id", "title", "items"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "title": { "type": "string", "minLength": 1 },
        "device_label": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } },
        "touch_items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } }
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": ["col"],
      "properties": {
        "col": { "enum": [0, 1] },
        "text": { "type": "string" },
        "heading": { "type": "string", "minLength": 1 },
        "note": { "enum": ["kbd_p2", "reopen"] },
        "icon": { "type": "string", "minLength": 1 },
        "stance": { "type": "string", "pattern": "^[a-z]+$" },
        "action": { "type": "string", "pattern": "^[a-z_]+$" },
        "actions": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z_]+$" } }
      },
      "additionalProperties": false
    }
  }
}
