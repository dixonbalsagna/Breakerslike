<?xml version="1.0" encoding="utf-8"?>
<!-- Offline restore for the probe: the only package source is the Godot 4.7.2 .NET editor's bundled nupkgs folder
     (installed outside the repo). <clear/> keeps nuget.org and any user sources out of the restore. -->
<configuration>
  <packageSources>
    <clear />
    <add key="godot-4.7.2-bundled" value="%LOCALAPPDATA%\Programs\Godot\4.7.2-mono\Godot_v4.7.2-stable_mono_win64\GodotSharp\Tools\nupkgs" />
  </packageSources>
</configuration>
