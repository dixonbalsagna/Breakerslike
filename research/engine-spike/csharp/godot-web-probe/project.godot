; Engine spike: the smallest possible Godot 4.7 C# (.NET) project, used only to ask the .NET editor to export it
; for the Web (and, for comparison, Windows and Android). Throwaway spike code (research/ only). See ../README.md.

config_version=5

[application]

config/name="WebProbe"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[dotnet]

project/assembly_name="WebProbe"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
