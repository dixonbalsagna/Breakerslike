; Engine spike project (throwaway, research only). The Godot render build owns and extends this file.
; Sim port: sim/, view/camera.gd, tests/. Renderer, demo, bench and exports: main.tscn, render/, bench/.

config_version=5

[application]

config/name="Meridian Engine Spike"
config/description="Throwaway engine spike for ADR 0001: 2.5D side-on renderer over the shared reference sim."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=0
boot_splash/show_image=false
boot_splash/bg_color=Color(0.1, 0.12, 0.16, 1)

[debug]

settings/stdout/print_fps=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.42, 0.6, 0.85, 1)
