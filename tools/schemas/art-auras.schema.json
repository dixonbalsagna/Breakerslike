                  "type": "string",
                  "minLength": 1
                },
                "hue": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 360,
                  "description": "Degrees on the colour wheel; Legal: 260 to 320 for the Anti-hero."
                },
                "pieces": {
                  "type": "string",
                  "minLength": 1
                },
                "aura": {
                  "type": "object",
                  "required": [
                    "rim",
                    "core",
                    "shadow",
                    "keyline"
                  ],
                  "properties": {
                    "rim": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "core": {
