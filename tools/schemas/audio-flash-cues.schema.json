{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/audio-flash-cues",
  "title": "audio flash cues (schema 1)",
  "description": "audio/data/flash_cues.json: the synthesised head-flash sounds, one per flash, in the fighter's family voice (audio/synth/flash_synth.gd). Version field: schema. Policy: the top level, families and flashes are closed; a layer must carry the keys its type needs and may carry more synth parameters. Cross-references (every flash id exists in data/art/flashes.json, every voice exists in grunts.json) are checked by tools/lib/xref.js.",
  "type": "object",
  "required": ["schema", "bank_seed", "rate", "families", "flashes"],
  "properties": {
    "schema": { "const": 1 },
    "bank_seed": { "type": "integer", "minimum": 0 },
    "rate": { "type": "integer", "minimum": 8000 },
    "note": { "type": "string" },
    "families": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "$ref": "#/$defs/family" }
    },
    "flashes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "$ref": "#/$defs/flash" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "family": {
      "type": "object",
      "required": ["voice", "root_hz", "wave"],
      "properties": {
        "voice": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "root_hz": { "type": "number", "exclusiveMinimum": 0 },
        "wave": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      },
      "additionalProperties": { "type": ["number", "string", "boolean"] }
    },
    "semi": { "type": ["number", "object"], "additionalProperties": { "type": "number" } },
    "layer": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["tick", "breath", "note", "growl", "thump"] },
        "at": { "type": "number", "minimum": 0 },
        "at_pulse": { "type": "integer", "minimum": 0 },
        "pulsed": { "type": "boolean" },
        "floor": { "type": "number", "minimum": 0, "maximum": 1 },
        "dur": { "type": "number", "exclusiveMinimum": 0 },
        "level": { "type": "number", "minimum": 0 },
        "semi": { "$ref": "#/$defs/semi" }
      },
      "oneOf": [{ "required": ["at"] }, { "required": ["at_pulse"] }],
      "allOf": [
        { "if": { "properties": { "type": { "const": "tick" } }, "required": ["type"] }, "then": { "required": ["f", "t60", "click", "level"] } },
        { "if": { "properties": { "type": { "const": "breath" } }, "required": ["type"] }, "then": { "required": ["dur", "filter", "f", "f_to", "q", "a", "hold", "t60", "level"] } },
        { "if": { "properties": { "type": { "const": "note" } }, "required": ["type"] }, "then": { "required": ["dur", "semi", "glide", "a", "hold", "t60", "level"] } },
        { "if": { "properties": { "type": { "const": "growl" } }, "required": ["type"] }, "then": { "required": ["dur", "f0", "f1", "swell", "level"] } },
        { "if": { "properties": { "type": { "const": "thump" } }, "required": ["type"] }, "then": { "required": ["f", "f_to", "t60", "level"] } }
      ],
      "additionalProperties": { "type": ["number", "string", "boolean", "object"] }
    },
    "flash": {
      "type": "object",
      "required": ["peak_db", "layers", "max_s"],
      "properties": {
        "peak_db": { "type": "number", "maximum": 0 },
        "layers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/layer" } },
        "max_s": { "type": "number", "exclusiveMinimum": 0 },
        "pulse": {
          "type": "object",
          "required": ["count", "on", "off", "fade"],
          "properties": {
            "count": { "type": "integer", "minimum": 1, "maximum": 5 },
            "on": { "type": "number", "exclusiveMinimum": 0 },
            "off": { "type": "number", "minimum": 0 },
            "fade": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        },
        "grow": { "type": "number", "exclusiveMinimum": 0 },
        "held": { "type": "boolean" }
      },
      "if": { "properties": { "held": { "const": true } }, "required": ["held"] },
      "else": { "required": ["pulse"] },
      "additionalProperties": false,
      "patternProperties": { "^_": true }
    }
  }
}
