{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/anim-wave-seqmap",
  "title": "anim.wave.seqmap/1 (no schema field)",
  "description": "data/anim/waves/<wave>.seqmap.json: the review map of a wave's sequences and cues (generated by render/anim/tools/wave_gen.mjs): one row per sequence with its poses and phase names, and a copy of the cues. Policy: closed except keys starting with an underscore. Cross-references (every row is a sequence of the wave and agrees with it on dur and poses; the phase names match its poses; every pose is in the wave's poses file; the cues equal the cues file's) are checked by tools/lib/xref-fight.js (wave-seq-map, wave-pose).",
  "type": "object",
  "required": [
    "wave",
    "kind",
    "sequences",
    "cues"
  ],
  "properties": {
    "wave": {
      "type": "string",
      "pattern": "^[a-z]+[0-9]+$"
    },
    "kind": {
      "const": "sequences"
    },
    "sequences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "dur",
          "alt",
          "poses",
          "phases"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "dur": {
            "type": "integer",
            "minimum": 1
          },
          "alt": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "poses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
            }
          },
          "phases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "description": "The phase names, in order (the last part of each pose id)."
          }
        },
        "additionalProperties": false,
        "patternProperties": {
          "^_": true
        }
      }
    },
    "cues": {
      "type": "object",
      "required": [
        "perfect_block",
        "reversal",
        "dodge_cancel",
        "burst",
        "burst_absorbed"
      ],
      "properties": {
        "perfect_block": {
          "type": "object",
          "required": [
            "actor"
          ],
          "properties": {
            "actor": {
              "description": "The sequence the fighter who did it plays.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
            },
            "other": {
              "description": "The sequence the other fighter plays.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
            },
            "other_if_stunned": {
              "description": "The other fighter's sequence when it was stunned by it.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
            },
            "other_if_shoved": {
              "description": "The other fighter's sequence when it was shoved.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "reversal": {
          "type": "object",
          "required": [
            "actor"
          ],
          "properties": {
            "actor": {
              "description": "The sequence the fighter who did it plays.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
            },
            "other": {
              "description": "The sequence the other fighter plays.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
            },
            "other_if_stunned": {
              "description": "The other fighter's sequence when it was stunned by it.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
            },
            "other_if_shoved": {
              "description": "The other fighter's sequence when it was shoved.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "dodge_cancel": {
          "type": "object",
          "required": [
            "actor"
          ],
          "properties": {
            "actor": {
              "description": "The sequence the fighter who did it plays.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
            },
            "other": {
              "description": "The sequence the other fighter plays.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
            },
            "other_if_stunned": {
              "description": "The other fighter's sequence when it was stunned by it.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
            },
            "other_if_shoved": {
              "description": "The other fighter's sequence when it was shoved.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "burst": {
          "type": "object",
          "required": [
            "actor"
          ],
          "properties": {
            "actor": {
              "description": "The sequence the fighter who did it plays.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
            },
            "other": {
              "description": "The sequence the other fighter plays.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
            },
            "other_if_stunned": {
              "description": "The other fighter's sequence when it was stunned by it.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
            },
            "other_if_shoved": {
              "description": "The other fighter's sequence when it was shoved.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "burst_absorbed": {
          "type": "object",
          "required": [
            "actor"
          ],
          "properties": {
            "actor": {
              "description": "The sequence the fighter who did it plays.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
            },
            "other": {
              "description": "The sequence the other fighter plays.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
            },
            "other_if_stunned": {
              "description": "The other fighter's sequence when it was stunned by it.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
            },
            "other_if_shoved": {
              "description": "The other fighter's sequence when it was shoved.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        }
      },
      "description": "Event kind to the sequences it plays.",
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^_": true
  }
}
