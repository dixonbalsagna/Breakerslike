{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/audio-mix",
  "title": "audio mix (schema 1)",
  "description": "audio/data/mix.json: playback settings for audio/audio_voices.gd (buses, voice cap, distance). Version field: schema. Policy: closed except underscore keys.",
  "type": "object",
  "required": ["schema", "voices", "buses", "master_limiter", "space"],
  "properties": {
    "schema": { "const": 1 },
    "note": { "type": "string" },
    "voices": { "type": "integer", "minimum": 1 },
    "buses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "volume_db"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
          "volume_db": { "type": "number" },
          "lowpass_hz": { "type": "number", "exclusiveMinimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "master_limiter": {
      "type": "object",
      "required": ["threshold_db", "ceiling_db"],
      "properties": { "threshold_db": { "type": "number", "maximum": 0 }, "ceiling_db": { "type": "number", "maximum": 0 } },
      "additionalProperties": false
    },
    "space": {
      "type": "object",
      "required": ["max_distance", "rolloff", "min_gain_db"],
      "properties": {
        "max_distance": { "type": "number", "exclusiveMinimum": 0 },
        "rolloff": { "type": "number", "exclusiveMinimum": 0 },
        "min_gain_db": { "type": "number", "maximum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
