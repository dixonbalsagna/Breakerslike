                  "type": "number",
                  "minimum": 0
                },
                "stagger": {
                  "enum": [
                    "none",
                    "light",
                    "heavy"
                  ]
                },
                "aura": {
                  "enum": [
                    "steady",
                    "flicker",
                    "gaps"
                  ]
                },
                "limb": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "description": "How the body looks and moves at this stage.",
              "additionalProperties": false,
              "patternProperties": {
                "^_": true
              }
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "3": {
          "type": "object",
          "required": [
            "name",
            "wear_stage",
            "orb_pick",
            "body"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "wear_stage": {
              "type": "string",
              "minLength": 1
            },
            "orb_pick": {
              "type": "string",
              "minLength": 1
            },
            "body": {
              "type": "object",
              "required": [
                "breathing",
                "breath_rate",
                "chest_rise_bh",
                "stagger",
                "aura",
                "limb"
              ],
              "properties": {
                "breathing": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "breath_rate": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "chest_rise_bh": {
                  "type": "number",
                  "minimum": 0
                },
                "stagger": {
                  "enum": [
                    "none",
                    "light",
                    "heavy"
                  ]
                },
                "aura": {
                  "enum": [
                    "steady",
                    "flicker",
                    "gaps"
                  ]
                },
                "limb": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "description": "How the body looks and moves at this stage.",
              "additionalProperties": false,
              "patternProperties": {
                "^_": true
              }
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "layers_note": {
      "type": "string"
    },
    "fighters": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(_.*|[a-z][a-z0-9_]*)$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "1",
          "2",
          "3"
        ],
        "properties": {
          "1": {
            "type": "object",
            "required": [
