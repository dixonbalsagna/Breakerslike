                "chest_rise_bh",
                "stagger",
                "aura",
                "limb"
              ],
              "properties": {
                "breathing": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "breath_rate": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
