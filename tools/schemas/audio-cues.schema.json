{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/audio-cues",
  "title": "audio cues (schema 1)",
  "description": "audio/data/cues.json: how fx events become sound cues (audio/audio_cues.gd). Version field: schema. Policy: the top level and the rule objects are closed except keys starting with an underscore; synth-style number tables are open. Cross-references (voices, buses, impact sounds, flash ranks) are checked by tools/lib/xref.js.",
  "type": "object",
  "required": ["schema", "fighters", "sounds", "damage", "crater", "grunts", "muffle", "variation", "flash"],
  "properties": {
    "schema": { "const": 1 },
    "note": { "type": "string" },
    "fighters": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
    "sounds": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["bus", "priority", "caption"],
        "properties": {
          "bus": { "type": "string", "minLength": 1 },
          "priority": { "type": "integer", "minimum": 0 },
          "caption": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "damage": {
      "type": "object",
      "required": ["classes", "ref", "pitch_exp", "pitch_min", "pitch_max", "gain_exp", "gain_db_min", "gain_db_max"],
      "properties": {
        "classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["below", "sound"],
            "properties": { "below": { "type": "number", "exclusiveMinimum": 0 }, "sound": { "type": "string", "minLength": 1 } },
            "additionalProperties": false
          }
        },
        "ref": { "type": "number", "exclusiveMinimum": 0 },
        "pitch_exp": { "type": "number" },
        "pitch_min": { "type": "number", "exclusiveMinimum": 0 },
        "pitch_max": { "type": "number", "exclusiveMinimum": 0 },
        "gain_exp": { "type": "number" },
        "gain_db_min": { "type": "number" },
        "gain_db_max": { "type": "number" }
      },
      "additionalProperties": false,
      "patternProperties": { "^_": true }
    },
    "crater": {
      "type": "object",
      "required": ["sound", "min_energy", "ref", "pitch_exp", "pitch_min", "pitch_max", "gain_exp", "gain_db_min", "gain_db_max"],
      "properties": {
        "sound": { "type": "string", "minLength": 1 },
        "min_energy": { "type": "number", "minimum": 0 },
        "ref": { "type": "number", "exclusiveMinimum": 0 },
        "pitch_exp": { "type": "number" },
        "pitch_min": { "type": "number", "exclusiveMinimum": 0 },
        "pitch_max": { "type": "number", "exclusiveMinimum": 0 },
        "gain_exp": { "type": "number" },
        "gain_db_min": { "type": "number" },
        "gain_db_max": { "type": "number" }
      },
      "additionalProperties": false,
      "patternProperties": { "^_": true }
    },
    "grunts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["on", "who", "min_amount", "chance", "cooldown_s", "priority", "gain_db"],
        "properties": {
          "on": { "enum": ["damage"] },
          "who": { "enum": ["attacker", "victim"] },
          "gesture": { "type": "string", "pattern": "^[a-z]+[.][a-z]+$" },
          "pool": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "number", "exclusiveMinimum": 0 } },
          "min_amount": { "type": "number", "minimum": 0 },
          "chance": { "type": "number", "minimum": 0, "maximum": 1 },
          "cooldown_s": { "type": "number", "minimum": 0 },
          "priority": { "type": "integer", "minimum": 0 },
          "gain_db": { "type": "number" },
          "pitch_per_ln": { "type": "number" },
          "ref": { "type": "number", "exclusiveMinimum": 0 },
          "note": { "type": "string" }
        },
        "oneOf": [{ "required": ["gesture"] }, { "required": ["pool"] }],
        "additionalProperties": false,
        "patternProperties": { "^_": true }
      }
    },
    "muffle": {
      "type": "object",
      "required": ["below_y", "over_sea_only"],
      "properties": { "below_y": { "type": "number" }, "over_sea_only": { "type": "boolean" } },
      "additionalProperties": false
    },
    "variation": {
      "type": "object",
      "required": ["pitch", "gain_db"],
      "properties": { "pitch": { "type": "number", "minimum": 0 }, "gain_db": { "type": "number", "minimum": 0 } },
      "additionalProperties": false
    },
    "flash": {
      "type": "object",
      "required": ["gain_db", "bus", "priority_base", "priority_step", "rank"],
      "properties": {
        "gain_db": { "type": "number" },
        "bus": { "type": "string", "minLength": 1 },
        "priority_base": { "type": "integer", "minimum": 0 },
        "priority_step": { "type": "integer", "minimum": 0 },
        "rank": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "integer", "minimum": 1 }, "patternProperties": { "^_": true } },
        "note": { "type": "string" },
        "held": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
