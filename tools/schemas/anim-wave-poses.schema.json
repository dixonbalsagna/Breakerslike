{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/anim-wave-poses",
  "title": "anim.wave.poses/1",
  "description": "data/anim/waves/<wave>.poses.json: the poses of a parked strike wave (generated by render/anim/tools/wave_gen.mjs; baked only with --waves). The same pose shape as data/anim/poses.json; names may carry a variant (`w1.uppercut~b.chamber`). `_legal` lists the Legal constraints a pose satisfies, `_orig` the Combat wording it realises. Render only. Version field: schema. Policy: closed except keys starting with an underscore.",
  "type": "object",
  "required": [
    "schema",
    "poses"
  ],
  "properties": {
    "schema": {
      "const": "anim.wave.poses/1"
    },
    "poses": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/pose"
      }
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^_": true
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "hand": {
      "enum": [
        "fist",
        "relaxed",
        "open",
        "claw"
      ]
    },
    "pose": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "family",
            "lean",
            "hand_r",
            "hand_l",
            "foot_r",
            "foot_l",
            "hands"
          ],
          "properties": {
            "family": {
              "enum": [
                "upright",
                "upright_lunge",
                "crouched",
                "kneel",
                "prone",
                "slide_brake",
                "tumble",
                "airborne_neutral",
                "airborne_extended"
              ]
            },
            "lean": {
              "type": "number"
            },
            "hips": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "spine": {
              "type": "object",
              "properties": {
                "lean": {
                  "type": "number"
                },
                "twist": {
                  "type": "number"
                },
                "bend": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            },
            "head": {
              "type": "object",
              "properties": {
                "pitch": {
                  "type": "number"
                },
                "yaw": {
                  "type": "number"
                },
                "roll": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            },
            "hand_r": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "hand_l": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "foot_r": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "foot_l": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "pole_hand_r": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "hands": {
              "type": "object",
              "required": [
                "l",
                "r"
              ],
              "properties": {
                "l": {
                  "$ref": "#/$defs/hand"
                },
                "r": {
                  "$ref": "#/$defs/hand"
                }
              },
              "additionalProperties": false
            },
            "pole_hand_l": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "pole_foot_r": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "pole_foot_l": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "hip_twist": {
              "type": "number",
              "description": "Degrees the hips turn about the vertical, on top of the family's own twist."
            },
            "_legal": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z_]+$"
              },
              "description": "Legal constraints this pose satisfies (hands_open_or_claw, not_at_hip, ...)."
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        {
          "type": "object",
          "required": [
            "additive",
            "fk"
          ],
          "properties": {
            "additive": {
              "const": true
            },
            "fk": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              }
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        }
      ]
    }
  }
}
