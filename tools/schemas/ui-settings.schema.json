{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/ui-settings",
  "title": "ui settings screen (schema 1)",
  "description": "ui/data/settings.json: the Settings screen (docs/ui/hud-spec.md section 26): its sections, which options each lists and in what order, the words for each choice and the screen's own words. The controls themselves come from options.json. Version field: schema. Policy: closed except keys starting with an underscore. Cross-references (every listed option exists in options.json, every needs names a flag in features.json, hidden and labels name real options, labels cover real choices, no option is listed twice, section ids are unique) are checked by tools/lib/xref.js.",
  "type": "object",
  "required": [
    "schema",
    "title",
    "close",
    "hint_keys",
    "hint_pad",
    "on",
    "off",
    "soon",
    "sections"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "note": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "close": {
      "type": "string",
      "minLength": 1
    },
    "hint_keys": {
      "type": "string",
      "minLength": 1
    },
    "hint_pad": {
      "type": "string",
      "minLength": 1
    },
    "on": {
      "type": "string",
      "minLength": 1
    },
    "off": {
      "type": "string",
      "minLength": 1
    },
    "soon": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "items"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                {
                  "type": "object",
                  "description": "An action button (not an option): it fires the named action.",
                  "required": [
                    "action",
                    "label"
                  ],
                  "properties": {
                    "action": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    },
                    "help": {
                      "type": "string",
                      "minLength": 1
                    },
                    "needs": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    }
                  },
                  "additionalProperties": false,
                  "patternProperties": {
                    "^_": true
                  }
                }
              ]
            }
          }
        },
        "additionalProperties": false,
        "patternProperties": {
          "^_": true
        }
      }
    },
    "needs": {
      "type": "object",
      "description": "option id to the feature flag (features.json) that must be on before the row is live.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "hidden": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "hidden_note": {
      "type": "string"
    },
    "labels": {
      "type": "object",
      "description": "option id to {choice: word}.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^_": true
  }
}
