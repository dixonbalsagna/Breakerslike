{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/input-timing",
  "title": "input timing (schema 1)",
  "description": "data/input/timing.json: every tick value of the input scheme: hold thresholds, the perfect-block windows, buffers and lockouts, the attack queue, the mode toggle, touch gestures, stick and trigger settings, and the hit-stop table (docs/controls/input-schema.md section 5; it carries over feel-schema.md's hit-stop, hold and stick values). Times are whole ticks at 60 per second unless a key says otherwise (px, dp, ki, fractions). Version field: schema. Policy: closed except keys starting with an underscore; hitstopTicks takes underscore comment keys. An unfunded signature is refused at once, so there is no unfunded-expiry key (I2c). chordWindow, stateTicks and awayDead are required; dodge.lungeTicks and stick.fullAt are optional (code defaults 12 and 0.9) until Controls' data carries them. Cross-references (timing-order, timing-perfect, timing-hold, timing-hitstop-order, timing-hitstop-budget) are checked by tools/lib/xref-input.js.",
  "type": "object",
  "required": [
    "schema",
    "ticksPerSecond",
    "tapHold",
    "perfectBlock",
    "dodge",
    "attackQueue",
    "mode",
    "touch",
    "stick",
    "hitstopTicks"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "ticksPerSecond": {
      "const": 60
    },
    "tapHold": {
      "type": "object",
      "required": [
        "holdStart",
        "transformConfirm",
        "encoreConfirm",
        "encoreOffer",
        "chordWindow"
      ],
      "properties": {
        "holdStart": {
          "type": "integer",
          "minimum": 1
        },
        "transformConfirm": {
          "type": "integer",
          "minimum": 1
        },
        "encoreConfirm": {
          "type": "integer",
          "minimum": 1
        },
        "encoreOffer": {
          "type": "integer",
          "minimum": 1
        },
        "chordWindow": {
          "type": "integer",
          "minimum": 1,
          "description": "Ticks within which the controls of a chord must all be down (I2c)."
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "perfectBlock": {
      "type": "object",
      "required": [
        "lightWindow",
        "heavyWindow",
        "buffer",
        "touchBufferBonus",
        "antiMashLockout",
        "assistFactor"
      ],
      "properties": {
        "lightWindow": {
          "type": "integer",
          "minimum": 1
        },
        "heavyWindow": {
          "type": "integer",
          "minimum": 1
        },
        "buffer": {
          "type": "integer",
          "minimum": 0
        },
        "touchBufferBonus": {
          "type": "integer",
          "minimum": 0
        },
        "antiMashLockout": {
          "type": "integer",
          "minimum": 0
        },
        "assistFactor": {
          "type": "number",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "dodge": {
      "type": "object",
      "required": [
        "buffer",
        "stateTicks"
      ],
      "properties": {
        "buffer": {
          "type": "integer",
          "minimum": 0
        },
        "stateTicks": {
          "type": "integer",
          "minimum": 1,
          "description": "Ticks the dodge state lasts (I2c)."
        },
        "lungeTicks": {
          "type": "integer",
          "minimum": 1,
          "description": "The free lunge (today's dash) that goes with a dodge, in ticks (12 by default in code until the director moves the fighter itself)."
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "attackQueue": {
      "type": "object",
      "required": [
        "max",
        "expiry",
        "upgradeWindow",
        "heavyKi",
        "signatureKi"
      ],
      "properties": {
        "max": {
          "type": "integer",
          "minimum": 1
        },
        "expiry": {
          "type": "integer",
          "minimum": 1
        },
        "upgradeWindow": {
          "type": "integer",
          "minimum": 1
        },
        "heavyKi": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "signatureKi": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "mode": {
      "type": "object",
      "required": [
        "toggleCooldown"
      ],
      "properties": {
        "toggleCooldown": {
          "type": "integer",
          "minimum": 0
        },
        "style": {
          "enum": [
            "hold",
            "toggle"
          ],
          "description": "How the mode control works by default: hold (momentary energy, the default) or toggle (the old latch, the accessibility setting)."
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "read": {
      "type": "object",
      "description": "The press reader (docs/controls/agency-input.md 1a, sim/input/press_read.gd): how holds, mashes and taps in time with the blows are told apart, and the contact debounce. Optional: the code defaults are these values.",
      "properties": {
        "logSize": {
          "type": "integer",
          "minimum": 3,
          "description": "Attack presses the press log keeps: the fight alchemist's read (5)."
        },
        "holdTicks": {
          "type": "integer",
          "minimum": 1,
          "description": "A button down this long is a hold; defaults to tapHold.holdStart."
        },
        "beatHalf": {
          "type": "integer",
          "minimum": 0,
          "description": "A press within this many ticks of a blow's contact is on the beat (4: an 8-tick window)."
        },
        "touchBeatHalf": {
          "type": "integer",
          "minimum": 0,
          "description": "The same on touch (5: 10 ticks)."
        },
        "rhythmOf": {
          "type": "integer",
          "minimum": 1,
          "description": "Rhythm looks at the last N presses ..."
        },
        "rhythmNeed": {
          "type": "integer",
          "minimum": 1,
          "description": "... and needs this many of them on the beat."
        },
        "mashPresses": {
          "type": "integer",
          "minimum": 2,
          "description": "A mash is this many presses ..."
        },
        "mashGap": {
          "type": "integer",
          "minimum": 1,
          "description": "... with every gap this many ticks or fewer."
        },
        "mashClear": {
          "type": "integer",
          "minimum": 1,
          "description": "A mash is over after this many ticks without a press."
        },
        "staleTicks": {
          "type": "integer",
          "minimum": 1,
          "description": "A log older than this reads as nothing."
        },
        "mixShort": {
          "type": "integer",
          "minimum": 1,
          "description": "The alchemist's short mix window, in presses."
        },
        "assistFactor": {
          "type": "integer",
          "minimum": 1,
          "description": "Accessibility: the beat window is multiplied by this."
        },
        "steadyJitter": {
          "type": "integer",
          "minimum": 0,
          "description": "A mash is steady when its gaps differ by this many ticks or fewer."
        },
        "perfectStreak": {
          "type": "integer",
          "minimum": 1,
          "description": "This many perfect presses in a row make a timed string."
        },
        "expireTicks": {
          "type": "integer",
          "minimum": 1,
          "description": "A press older than this no longer counts in the recipe mix or the running mix (90)."
        },
        "debounce": {
          "type": "integer",
          "minimum": 0,
          "description": "A press of an attack button within this many ticks of its own release is the same press."
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "touch": {
      "type": "object",
      "required": [
        "flickToDodgeTicks",
        "flickThreshold",
        "outerRingScale",
        "outerRingHold",
        "fullDeflectionSprint",
        "swipeUpPx",
        "swipeUpTicks",
        "edgeIgnoreDp"
      ],
      "properties": {
        "flickToDodgeTicks": {
          "type": "integer",
          "minimum": 1
        },
        "flickThreshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "outerRingScale": {
          "type": "number",
          "minimum": 1
        },
        "outerRingHold": {
          "type": "integer",
          "minimum": 1
        },
        "fullDeflectionSprint": {
          "type": "integer",
          "minimum": 1
        },
        "swipeUpPx": {
          "type": "integer",
          "minimum": 1
        },
        "swipeUpTicks": {
          "type": "integer",
          "minimum": 1
        },
        "edgeIgnoreDp": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "stick": {
      "type": "object",
      "required": [
        "deadzone",
        "quant",
        "triggerOn",
        "triggerOff",
        "awayDead"
      ],
      "properties": {
        "deadzone": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 0.5
        },
        "quant": {
          "type": "integer",
          "minimum": 2,
          "maximum": 127
        },
        "triggerOn": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "triggerOff": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "awayDead": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1,
          "description": "The dead zone for pushing away (I2c)."
        },
        "fullAt": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "A stick reaches full speed at this fraction of its travel (0.9 by default in code)."
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "hitstopTicks": {
      "type": "object",
      "required": [
        "light",
        "chain",
        "tradeFinal",
        "heavy",
        "guardBreak",
        "parry",
        "clashWave",
        "impact",
        "explosion",
        "beamConnect",
        "beamClash",
        "finisherHit1",
        "finisherHit2",
        "finalBlow"
      ],
      "propertyNames": {
        "pattern": "^(_.*|[a-z][A-Za-z0-9]*)$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 60
      },
      "patternProperties": {
        "^_": true
      }
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^_": true
  }
}
