            },
            "other_if_shoved": {
              "description": "The other fighter's sequence when it was shoved.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        }
      },
      "description": "Event kind to the sequences it plays.",
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^_": true
  }
