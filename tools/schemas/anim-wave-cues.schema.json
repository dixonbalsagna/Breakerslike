              "description": "The sequence the other fighter plays.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
            },
            "other_if_stunned": {
              "description": "The other fighter's sequence when it was stunned by it.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
            },
            "other_if_shoved": {
              "description": "The other fighter's sequence when it was shoved.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "dodge_cancel": {
          "type": "object",
          "required": [
            "actor"
          ],
