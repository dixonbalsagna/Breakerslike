{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/director-interrupts",
  "title": "director.interrupts/1",
  "description": "data/director/interrupts.json: control-scheme step 3 (ADR 0008; control-rules.md sections 1, 2 and 6): the costs, cooldowns and windows of what a fighter does inside an exchange, read by sim/director/interrupt.gd (DirInterrupt). Ticks are sim ticks (60 a second); ki is out of 100. Version field: schema. Policy: closed except keys starting with an underscore; every key required except the window classes (a class not listed has no window). Orders (kiPatient at most ki; the stale maximums are at least one repeat's step; a one-armed blocker keeps a window; light at most heavy; a window not longer than its wind-up, a warning) are checked by tools/lib/xref-fight.js (interrupts-*).",
  "type": "object",
  "required": [
    "schema",
    "perfectBlock",
    "dodgeCancel",
    "burst",
    "reversal",
    "blockedString",
    "arrival",
    "stale",
    "bands"
  ],
  "properties": {
    "schema": {
      "const": "director.interrupts/1"
    },
    "perfectBlock": {
      "type": "object",
      "required": [
        "ki",
        "stopTicks",
        "windows",
        "early",
        "oneArmedOff"
      ],
      "properties": {
        "ki": {
          "description": "Gained by the blocker.",
          "type": "integer",
          "minimum": 0
        },
        "stopTicks": {
          "description": "The hit-stop on the block.",
          "type": "integer",
          "minimum": 0
        },
        "windows": {
          "type": "object",
          "required": [],
          "properties": {
            "opener": {
              "type": "object",
              "required": [
                "light",
                "heavy"
              ],
              "properties": {
                "light": {
                  "type": "integer",
                  "minimum": 0
                },
                "heavy": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "description": "Depends on the exchange's weight.",
              "additionalProperties": false,
              "patternProperties": {
                "^_": true
              }
            },
            "heavy": {
              "type": "integer",
              "minimum": 0
            },
            "ender": {
              "type": "integer",
              "minimum": 0
            },
            "blast": {
              "type": "object",
              "required": [
                "light",
                "heavy"
              ],
              "properties": {
                "light": {
                  "type": "integer",
                  "minimum": 0
                },
                "heavy": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "description": "Depends on the exchange's weight.",
              "additionalProperties": false,
              "patternProperties": {
                "^_": true
              }
            },
            "return": {
              "type": "integer",
              "minimum": 0
            }
          },
          "description": "The last ticks of the wind-up in which a fresh guard press is a perfect block, by strike class (moveset-rules.md section 11(f)); a class not listed has no window.",
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "early": {
          "type": "object",
          "required": [
            "default",
            "return"
          ],
          "properties": {
            "default": {
              "type": "integer",
              "minimum": 0
            },
            "return": {
              "type": "integer",
              "minimum": 0
            }
          },
          "description": "Ticks before the window opens in which a press still counts, by class.",
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "oneArmedOff": {
          "description": "Ticks off every window for a blocker with a broken arm.",
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "dodgeCancel": {
      "type": "object",
      "required": [
        "ki",
        "cooldownTicks",
        "gapTicks",
        "dash",
        "freeBeforeWindup",
        "freeGapTicks"
      ],
      "properties": {
        "ki": {
          "type": "integer",
          "minimum": 0
        },
        "cooldownTicks": {
          "type": "integer",
          "minimum": 0
        },
        "gapTicks": {
          "description": "The defender may cancel only this long after it was last struck (a gap between strikes, never hit-stun).",
          "type": "integer",
          "minimum": 0
        },
        "dash": {
          "description": "The speed of the dash in the held direction, units a second.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "freeBeforeWindup": {
          "type": "boolean",
          "description": "The attacker's cancel costs nothing until his first wind-up starts (agency-pass.md section 1, solution E)."
        },
        "freeGapTicks": {
          "type": "integer",
          "minimum": 0,
          "description": "Then it starts this many ticks of cooldown, and not cooldownTicks."
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "burst": {
      "type": "object",
      "required": [
        "ki",
        "cooldownTicks",
        "rangeBh",
        "pushSpeed",
        "baitStaggerTicks",
        "threatTicks",
        "autoLink"
      ],
      "properties": {
        "ki": {
          "type": "integer",
          "minimum": 0
        },
        "cooldownTicks": {
          "type": "integer",
          "minimum": 0
        },
        "rangeBh": {
          "description": "A rival within this many body heights is shoved.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pushSpeed": {
          "description": "The shove, units a second.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "baitStaggerTicks": {
          "type": "integer",
          "minimum": 0
        },
        "threatTicks": {
          "description": "A fighter struck within this long is being hit, so a power press bursts at once.",
          "type": "integer",
          "minimum": 0
        },
        "autoLink": {
          "description": "The chain link at which a Simple-layout slot bursts when it pressed nothing.",
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "reversal": {
      "type": "object",
      "required": [
        "ki",
        "kiPatient",
        "patientTicks",
        "cooldownTicks",
        "afterBlockTicks",
        "delayTicks",
        "landTicks"
      ],
      "properties": {
        "ki": {
          "type": "integer",
          "minimum": 0
        },
        "kiPatient": {
          "description": "The ki after patientTicks of continuous guard.",
          "type": "integer",
          "minimum": 0
        },
        "patientTicks": {
          "type": "integer",
          "minimum": 0
        },
        "cooldownTicks": {
          "type": "integer",
          "minimum": 0
        },
        "afterBlockTicks": {
          "type": "integer",
          "minimum": 0
        },
        "delayTicks": {
          "type": "integer",
          "minimum": 0
        },
        "landTicks": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "blockedString": {
      "type": "object",
      "required": [
        "behindTicks"
      ],
      "properties": {
        "behindTicks": {
          "description": "A string blocked to its end leaves the attacker unable to act for this long.",
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "stale": {
      "type": "object",
      "required": [
        "after",
        "windupPerRepeat",
        "windupMax",
        "windowPerRepeat",
        "windowMax"
      ],
      "properties": {
        "after": {
          "description": "The same weight, mode and direction in this many exchanges running.",
          "type": "integer",
          "minimum": 1
        },
        "windupPerRepeat": {
          "type": "integer",
          "minimum": 0
        },
        "windupMax": {
          "type": "integer",
          "minimum": 0
        },
        "windowPerRepeat": {
          "type": "integer",
          "minimum": 0
        },
        "windowMax": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "arrival": {
      "type": "object",
      "required": [
        "tiltDead",
        "riseBh",
        "overShare"
      ],
      "properties": {
        "tiltDead": {
          "description": "The stick must pass this (0 to 1) up or down as he presses.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "riseBh": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "How far over (or under) the rival the approach passes, in body heights."
        },
        "overShare": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1,
          "description": "The share of the approach spent reaching the point above him."
        }
      },
      "description": "The attacker's arrival side: with the stick up or down past tiltDead as he presses, his approach passes over (or under) the rival and lands on the far side.",
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "bands": {
      "type": "object",
      "required": [
        "enabled",
        "closeBh",
        "midBh",
        "engageBh",
        "lunge",
        "far",
        "hysteresisBh",
        "taunt",
        "charge",
        "meet"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "The ranged press switch."
        },
        "closeBh": {
          "description": "A press within this many body heights (75 u; centre to centre, the shortest arc and the height together) starts its exchange at once.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "midBh": {
          "description": "Mid band: to this many body heights; far beyond.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "engageBh": {
          "description": "A press from farther off starts only the approach, which ends this far from the rival.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "lunge": {
          "type": "object",
          "required": [
            "speed",
            "minTicks",
            "maxTicks"
          ],
          "properties": {
            "speed": {
              "description": "Units a second.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "minTicks": {
              "type": "integer",
              "minimum": 1,
              "description": "The approach lasts at least this many whole ticks."
            },
            "maxTicks": {
              "type": "integer",
              "minimum": 1,
              "description": "And at most this many."
            }
          },
          "description": "The mid band's approach: the distance to cover at `speed`, in whole ticks between minTicks and maxTicks.",
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "far": {
          "type": "object",
          "required": [
            "light",
            "heavy"
          ],
          "properties": {
            "light": {
              "type": "object",
              "required": [
                "speed",
                "minTicks",
                "maxTicks"
              ],
              "properties": {
                "speed": {
                  "description": "Units a second.",
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "minTicks": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "The approach lasts at least this many whole ticks."
                },
                "maxTicks": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "And at most this many."
                }
              },
              "description": "The far band's approach for a light press.",
              "additionalProperties": false,
              "patternProperties": {
                "^_": true
              }
            },
            "heavy": {
              "type": "object",
              "required": [
                "speed",
                "minTicks",
                "maxTicks"
              ],
              "properties": {
                "speed": {
                  "description": "Units a second.",
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "minTicks": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "The approach lasts at least this many whole ticks."
                },
                "maxTicks": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "And at most this many."
                }
              },
              "description": "The far band's approach for a heavy press.",
              "additionalProperties": false,
              "patternProperties": {
                "^_": true
              }
            }
          },
          "description": "The far band, by the press's weight.",
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "hysteresisBh": {
          "type": "number",
          "minimum": 0,
          "description": "The hysteresis, in body heights, at the edge of a band (Game Design's band rule): a pair that crossed a band edge must cross back by this much before it changes band again."
        },
        "taunt": {
          "type": "object",
          "required": [
            "enabled",
            "windowTicks"
          ],
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "The far taunt switch."
            },
            "windowTicks": {
              "type": "integer",
              "minimum": 1,
              "description": "The ticks the taunt's window stays open."
            }
          },
          "description": "The far taunt.",
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "charge": {
          "type": "object",
          "required": [
            "light",
            "heavy"
          ],
          "properties": {
            "light": {
              "type": "object",
              "required": [
                "holdTicks",
                "speed",
                "minTicks",
                "maxTicks"
              ],
              "properties": {
                "holdTicks": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "The ticks the press is held to count as a charge."
                },
                "speed": {
                  "description": "Units a second.",
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "minTicks": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxTicks": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "description": "The held light press's charged flight.",
              "additionalProperties": false,
              "patternProperties": {
                "^_": true
              }
            },
            "heavy": {
              "type": "object",
              "required": [
                "holdTicks",
                "speed",
                "minTicks",
                "maxTicks"
              ],
              "properties": {
                "holdTicks": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "The ticks the press is held to count as a charge."
                },
                "speed": {
                  "description": "Units a second.",
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "minTicks": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxTicks": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "description": "The held heavy press's charged flight.",
              "additionalProperties": false,
              "patternProperties": {
                "^_": true
              }
            }
          },
          "description": "The held charge: a press held this long flies in on its own approach.",
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "meet": {
          "type": "object",
          "required": [
            "speed",
            "minTicks",
            "maxTicks",
            "chargerEdge"
          ],
          "properties": {
            "speed": {
              "description": "Units a second.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "minTicks": {
              "type": "integer",
              "minimum": 1,
              "description": "At least this many whole ticks."
            },
            "maxTicks": {
              "type": "integer",
              "minimum": 1,
              "description": "At most this many."
            },
            "chargerEdge": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Points off the attacker's chance when the rival is charging (the charger's edge); 0 to 100 (a share of 0 to 1 also fits)."
            }
          },
          "description": "The meeting: both fighters closing on each other.",
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        }
      },
      "description": "The ranged press (agency-pass.md section 1; sim/director/bands.gd). Orders (engageBh at most closeBh, closeBh below midBh, minTicks at most maxTicks) are checked by tools/lib/xref-fight.js (bands-order).",
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^_": true
  }
}
