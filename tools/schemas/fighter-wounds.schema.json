{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/fighter-wounds",
  "title": "wounds/1 (draft, from docs/architecture/d1-roster-data.md section 3 and sim/core/wounds.gd)",
  "description": "data/fighters/<id>/wounds.json: the per-fighter wound numbers, under the names of today's SimWounds constants. DRAFT: derived from the D1 plan and wounds.gd before any data exists; the penalties table is left open until D1a fixes its shape. Version field: schema. Policy: closed at the top level and in the tables below, except keys starting with an underscore. Integer fields (units and ticks) must be integral; other numbers carry at most 15 significant digits (checked by the validator).",
  "type": "object",
  "required": ["schema", "regions", "stageAt", "wearPerDamage", "fade", "focusWear", "family", "penalties", "profile", "rally"],
  "properties": {
    "schema": { "const": "wounds/1" },
    "regions": {
      "type": "object",
      "required": ["head", "core", "arms", "legs"],
      "propertyNames": { "pattern": "^(head|core|arms|legs|mantle)$" },
      "additionalProperties": {
        "type": "object",
        "required": ["brink"],
        "properties": { "brink": { "type": "boolean" } },
        "additionalProperties": false,
        "patternProperties": { "^_": true }
      },
      "patternProperties": { "^_": true }
    },
    "stageAt": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "integer", "exclusiveMinimum": 0 },
      "description": "Wear thresholds for the three stages, in units; strictly increasing (checked by tools/lib/xref.js)."
    },
    "wearPerDamage": { "type": "number", "exclusiveMinimum": 0 },
    "fade": {
      "type": "object",
      "required": ["out", "breath", "breathAfterTicks", "hidden", "hiddenFloor"],
      "properties": {
        "out": { "type": "integer", "minimum": 0 },
        "breath": { "type": "integer", "minimum": 0 },
        "breathAfterTicks": { "type": "integer", "minimum": 0 },
        "hidden": { "type": "integer", "minimum": 0 },
        "hiddenFloor": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false,
      "patternProperties": { "^_": true }
    },
    "focusWear": { "type": "number", "exclusiveMinimum": 0 },
    "family": {
      "type": "object",
      "required": ["light", "heavy", "guard", "spread"],
      "additionalProperties": {
        "type": "array",
        "minItems": 4,
        "maxItems": 5,
        "items": { "type": "number", "minimum": 0 }
      },
      "patternProperties": { "^_": true },
      "description": "Region pick weights per hit family, in region order (head, core, arms, legs; a fifth for the mantle)."
    },
    "penalties": { "type": "object", "minProperties": 1 },
    "profile": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "enum": ["plain"] } },
      "additionalProperties": { "type": ["number", "string", "boolean", "array", "object"] },
      "patternProperties": { "^_": true }
    },
    "rally": {
      "type": "object",
      "required": ["rallyWear", "coolTicks"],
      "properties": {
        "rallyWear": { "type": "integer", "exclusiveMinimum": 0 },
        "coolTicks": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false,
      "patternProperties": { "^_": true }
    }
  },
  "additionalProperties": false,
  "patternProperties": { "^_": true }
}
