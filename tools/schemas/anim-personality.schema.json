{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/anim-personality",
  "title": "anim.personality/1",
  "description": "data/anim/personality.json: idles and transitions with personality (docs/animation/overhaul-plan.md, unit F): the stances' weight shift, bounce and breath, the forms' scales, the guard's arm kicks and the turn-around step. Render only, outside the sim's data hash. Version field: schema. Policy: closed except keys starting with an underscore. A higher tier is calmer (sway, hz, bounce and breath_hz do not rise; breath_amp does not fall): a warning if not (tools/lib/xref-fight.js, personality-tiers).",
  "type": "object",
  "required": [
    "schema",
    "stances",
    "tiers",
    "guard",
    "turn"
  ],
  "properties": {
    "schema": {
      "const": "anim.personality/1"
    },
    "stances": {
      "type": "object",
      "required": [
        "aggressive",
        "defensive",
        "evasive",
        "escape"
      ],
      "properties": {
        "aggressive": {
          "type": "object",
          "required": [
            "sway",
            "hz",
            "bounce",
            "bounce_hz",
            "heel",
            "breath"
          ],
          "properties": {
            "sway": {
              "type": "number",
              "minimum": 0
            },
            "hz": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "bounce": {
