{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/anim-wave-keysets",
  "title": "anim.wave.keysets/1",
  "description": "data/anim/waves/<wave>.keysets.json: the key sets of a parked strike wave (generated by render/anim/tools/wave_gen.mjs; baked only with --waves, no live match plays them). The same key set shape as data/anim/keysets.json, without picks; names may carry a variant (`w1.uppercut~b`). `_combat` is the Combat strike id it realises, `_wave` its wave, `_variant` and `_alt` a second take and what differs. Render only. Version field: schema. Policy: closed except keys starting with an underscore. Cross-references (every key pose is in the wave's poses file; each role once; target is a sockets.json region and limb and limb2 are sockets.json limbs) are checked by tools/lib/xref-fight.js (wave-*, anim-target, anim-limb).",
  "type": "object",
  "required": [
    "schema",
    "keysets"
  ],
  "properties": {
    "schema": {
      "const": "anim.wave.keysets/1"
    },
    "keysets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "weight",
          "keys"
        ],
        "properties": {
          "weight": {
            "enum": [
              "light",
              "any",
              "heavy"
            ]
          },
          "keys": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": [
                "role",
                "pose"
              ],
              "properties": {
                "role": {
                  "enum": [
                    "load",
                    "contact",
                    "follow"
                  ]
                },
                "pose": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
                }
              },
              "additionalProperties": false
            }
          },
          "target": {
            "type": "string",
            "pattern": "^[a-z][a-z_]*$",
            "description": "Where the strike lands on the opponent (head, chest, gut ...)."
          },
          "limb": {
            "enum": [
              "hand_r",
              "hand_l",
              "foot_r",
              "foot_l",
              "elbow_r",
              "elbow_l",
              "knee_r",
              "knee_l",
              "shoulder_r",
              "shoulder_l",
              "head"
            ],
            "description": "The limb that strikes: a part of sockets.json limbs, with its side (hand_r, foot_l, elbow_r, knee_l, shoulder_r) or head (no side)."
          },
          "step_max": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "How far (model units) the whole body may step to reach the target, overriding the limb's step_max in sockets.json."
          },
          "limb2": {
            "enum": [
              "hand_r",
              "hand_l",
              "foot_r",
              "foot_l",
              "elbow_r",
              "elbow_l",
              "knee_r",
              "knee_l",
              "shoulder_r",
              "shoulder_l",
              "head"
            ],
            "description": "A second striking limb, for a two-limbed blow (a double palm, a clap)."
          },
          "_combat": {
            "type": "string",
            "pattern": "^strike\\.[a-z0-9_]+$"
          },
          "_wave": {
            "type": "string",
            "pattern": "^(wave|protag)[0-9]+$"
          },
          "_variant": {
            "type": "string",
            "pattern": "^[a-z0-9]+$"
          },
          "_alt": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "patternProperties": {
          "^_": true
        }
      }
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^_": true
  }
}
