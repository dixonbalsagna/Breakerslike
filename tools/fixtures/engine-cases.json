{
  "_about": "Unit cases for tools/lib/schema.js. Each case gives an inline schema, an instance, and the errors expected as [pointer, rule] pairs (an empty list means the instance must be valid). Every supported keyword appears at least once, as passing and as failing.",
  "cases": [
    { "id": "type-string", "schema": { "type": "string" }, "instance": 1, "expect": [["", "type"]] },
    { "id": "type-union", "schema": { "type": ["string", "null"] }, "instance": null, "expect": [] },
    { "id": "type-integer-rejects-fraction", "schema": { "type": "integer" }, "instance": 1.5, "expect": [["", "type"]] },
    { "id": "type-integer-accepts-whole", "schema": { "type": "integer" }, "instance": 3, "expect": [] },
    { "id": "type-object-rejects-array", "schema": { "type": "object" }, "instance": [], "expect": [["", "type"]] },
    { "id": "enum", "schema": { "enum": ["a", "b"] }, "instance": "c", "expect": [["", "enum"]] },
    { "id": "enum-null", "schema": { "enum": [null, 1] }, "instance": null, "expect": [] },
    { "id": "const-object", "schema": { "const": { "a": [1, 2] } }, "instance": { "a": [1, 3] }, "expect": [["", "const"]] },
    { "id": "required", "schema": { "required": ["a", "b"] }, "instance": { "a": 1 }, "expect": [["", "required"]] },
    { "id": "properties", "schema": { "properties": { "a": { "type": "number" } } }, "instance": { "a": "x" }, "expect": [["/a", "type"]] },
    { "id": "additionalProperties-false", "schema": { "properties": { "a": {} }, "additionalProperties": false }, "instance": { "a": 1, "b": 2 }, "expect": [["/b", "additionalProperties"]] },
    { "id": "additionalProperties-schema", "schema": { "additionalProperties": { "type": "number" } }, "instance": { "a": 1, "b": "x" }, "expect": [["/b", "type"]] },
    { "id": "patternProperties-exempts-comments", "schema": { "additionalProperties": false, "patternProperties": { "^_": true } }, "instance": { "_note": "hi" }, "expect": [] },
    { "id": "patternProperties-checks-value", "schema": { "patternProperties": { "^n": { "type": "number" } } }, "instance": { "n1": "x" }, "expect": [["/n1", "type"]] },
    { "id": "propertyNames", "schema": { "propertyNames": { "pattern": "^[a-z]+$" } }, "instance": { "ok": 1, "Bad": 2 }, "expect": [["/Bad", "propertyNames"]] },
    { "id": "minProperties", "schema": { "minProperties": 2 }, "instance": { "a": 1 }, "expect": [["", "minProperties"]] },
    { "id": "maxProperties", "schema": { "maxProperties": 1 }, "instance": { "a": 1, "b": 2 }, "expect": [["", "maxProperties"]] },
    { "id": "dependentRequired", "schema": { "dependentRequired": { "min": ["max"] } }, "instance": { "min": 1 }, "expect": [["", "dependentRequired"]] },
    { "id": "items", "schema": { "items": { "type": "integer" } }, "instance": [1, "x", 3], "expect": [["/1", "type"]] },
    { "id": "prefixItems-then-items", "schema": { "prefixItems": [{ "const": "A" }], "items": { "type": "number" } }, "instance": ["A", 1, "x"], "expect": [["/2", "type"]] },
    { "id": "minItems", "schema": { "minItems": 2 }, "instance": [1], "expect": [["", "minItems"]] },
    { "id": "maxItems", "schema": { "maxItems": 1 }, "instance": [1, 2], "expect": [["", "maxItems"]] },
    { "id": "uniqueItems-deep", "schema": { "uniqueItems": true }, "instance": [{ "a": 1, "b": 2 }, { "b": 2, "a": 1 }], "expect": [["/1", "uniqueItems"]] },
    { "id": "minimum", "schema": { "minimum": 0 }, "instance": -1, "expect": [["", "minimum"]] },
    { "id": "minimum-boundary-ok", "schema": { "minimum": 0 }, "instance": 0, "expect": [] },
    { "id": "maximum", "schema": { "maximum": 1 }, "instance": 2, "expect": [["", "maximum"]] },
    { "id": "exclusiveMinimum", "schema": { "exclusiveMinimum": 0 }, "instance": 0, "expect": [["", "exclusiveMinimum"]] },
    { "id": "exclusiveMaximum", "schema": { "exclusiveMaximum": 1 }, "instance": 1, "expect": [["", "exclusiveMaximum"]] },
    { "id": "multipleOf", "schema": { "multipleOf": 0.25 }, "instance": 0.3, "expect": [["", "multipleOf"]] },
    { "id": "minLength-counts-characters", "schema": { "minLength": 2 }, "instance": "😀", "expect": [["", "minLength"]] },
    { "id": "maxLength", "schema": { "maxLength": 2 }, "instance": "abc", "expect": [["", "maxLength"]] },
    { "id": "pattern", "schema": { "pattern": "^#[0-9a-f]{6}$" }, "instance": "#12", "expect": [["", "pattern"]] },
    { "id": "allOf", "schema": { "allOf": [{ "type": "number" }, { "minimum": 5 }] }, "instance": 3, "expect": [["", "minimum"]] },
    { "id": "anyOf-passes", "schema": { "anyOf": [{ "type": "string" }, { "type": "number" }] }, "instance": 1, "expect": [] },
    { "id": "anyOf-fails", "schema": { "anyOf": [{ "type": "string" }, { "type": "number" }] }, "instance": true, "expect": [["", "anyOf"]] },
    { "id": "oneOf-none", "schema": { "oneOf": [{ "type": "string" }, { "type": "number" }] }, "instance": null, "expect": [["", "oneOf"]] },
    { "id": "oneOf-two", "schema": { "oneOf": [{ "type": "number" }, { "minimum": 0 }] }, "instance": 1, "expect": [["", "oneOf"]] },
    { "id": "not", "schema": { "not": { "const": 1 } }, "instance": 1, "expect": [["", "not"]] },
    { "id": "if-then", "schema": { "if": { "properties": { "k": { "const": 1 } }, "required": ["k"] }, "then": { "required": ["a"] } }, "instance": { "k": 1 }, "expect": [["", "required"]] },
    { "id": "if-else", "schema": { "if": { "properties": { "k": { "const": 1 } }, "required": ["k"] }, "else": { "required": ["b"] } }, "instance": { "k": 2 }, "expect": [["", "required"]] },
    { "id": "if-skips-then-when-false", "schema": { "if": { "properties": { "k": { "const": 1 } }, "required": ["k"] }, "then": { "required": ["a"] } }, "instance": { "k": 2 }, "expect": [] },
    { "id": "ref-defs", "schema": { "$ref": "#/$defs/n", "$defs": { "n": { "type": "number" } } }, "instance": "x", "expect": [["", "type"]] },
    { "id": "ref-recursive", "schema": { "$ref": "#/$defs/tree", "$defs": { "tree": { "type": "object", "properties": { "kids": { "type": "array", "items": { "$ref": "#/$defs/tree" } } } } } }, "instance": { "kids": [{ "kids": [{ "kids": 5 }] }] }, "expect": [["/kids/0/kids/0/kids", "type"]] },
    { "id": "false-schema", "schema": { "properties": { "gone": false } }, "instance": { "gone": 1 }, "expect": [["/gone", "false"]] },
    { "id": "pointer-escapes", "schema": { "properties": { "a/b": { "type": "number" }, "c~d": { "type": "number" } } }, "instance": { "a/b": "x", "c~d": "y" }, "expect": [["/a~1b", "type"], ["/c~0d", "type"]] },
    { "id": "annotations-are-ignored", "schema": { "$comment": "x", "title": "t", "description": "d", "default": 1, "examples": [1], "deprecated": true, "format": "email", "type": "string" }, "instance": "not an email", "expect": [] }
  ],
  "unsupported": [
    { "id": "unevaluatedProperties", "schema": { "unevaluatedProperties": false } },
    { "id": "contains", "schema": { "contains": { "type": "number" } } },
    { "id": "dependentSchemas", "schema": { "dependentSchemas": {} } },
    { "id": "unknown-type-name", "schema": { "type": "text" } },
    { "id": "broken-ref", "schema": { "$ref": "#/$defs/missing" } },
    { "id": "bad-regex", "schema": { "pattern": "([" } }
  ]
}
